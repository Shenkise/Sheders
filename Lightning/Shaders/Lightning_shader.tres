render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform sampler2D tex_frg_2;



void fragment() {
// Input:8
	vec4 n_out8p0 = COLOR;
	float n_out8p1 = n_out8p0.r;


	float n_out7p0;
// Remap:7
	float n_in7p1 = 0.00000;
	float n_in7p2 = 1.00000;
	float n_in7p3 = 0.00000;
	float n_in7p4 = 0.70000;
	{
		float __input_range = n_in7p2 - n_in7p1;
		float __output_range = n_in7p4 - n_in7p3;
		n_out7p0 = n_in7p3 + __output_range * ((n_out8p1 - n_in7p1) / __input_range);
	}


// Input:4
	float n_out4p0 = TIME;


// VectorOp:5
	vec2 n_in5p1 = vec2(0.00000, -0.50000);
	vec2 n_out5p0 = vec2(n_out4p0) * n_in5p1;


// UVFunc:3
	vec2 n_in3p1 = vec2(1.00000, 1.00000);
	vec2 n_out3p0 = n_out5p0 * n_in3p1 + UV;


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, n_out3p0);
	float n_out2p1 = n_out2p0.r;


// SmoothStep:6
	float n_in6p1 = 1.00000;
	float n_out6p0 = smoothstep(n_out7p0, n_in6p1, n_out2p1);


// Output:0
	ALPHA = n_out6p0;


}
