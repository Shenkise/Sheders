code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform vec2 Vector2Parameter = vec2(0.200000, 0.750000);
uniform sampler2D tex_vtx_8 : source_color;
uniform float vertex_size = -0.5;
uniform float floor_distance = 0.30000001192093;
uniform sampler2D depth_tex_frg_3 : hint_depth_texture;



void vertex() {
// Input:2
	vec3 n_out2p0 = VERTEX;


// Input:4
	vec3 n_out4p0 = NORMAL;


// Input:12
	float n_out12p0 = TIME;


// VectorCompose:13
	float n_in13p1 = 0.00000;
	vec2 n_out13p0 = vec2(n_out12p0, n_in13p1);


// Vector2Parameter:15
	vec2 n_out15p0 = Vector2Parameter;


// VectorOp:14
	vec2 n_out14p0 = n_out13p0 * n_out15p0;


// UVFunc:11
	vec2 n_in11p1 = vec2(1.00000, 1.00000);
	vec2 n_out11p0 = n_out14p0 * n_in11p1 + UV;


// Texture2D:8
	vec4 n_out8p0 = texture(tex_vtx_8, n_out11p0);
	float n_out8p1 = n_out8p0.r;


// VectorOp:9
	vec3 n_out9p0 = n_out4p0 * vec3(n_out8p1);


// FloatParameter:10
	float n_out10p0 = vertex_size;


// VectorOp:7
	vec3 n_out7p0 = n_out9p0 * vec3(n_out10p0);


// VectorOp:3
	vec3 n_out3p0 = n_out2p0 + n_out7p0;


// Output:0
	VERTEX = n_out3p0;


}

void fragment() {
// Input:2
	vec4 n_out2p0 = COLOR;
	float n_out2p4 = n_out2p0.a;


// FloatParameter:5
	float n_out5p0 = floor_distance;


	float n_out3p0;
// ProximityFade:3
	{
		float __depth_tex = texture(depth_tex_frg_3, SCREEN_UV).r;
		vec4 __depth_world_pos = INV_PROJECTION_MATRIX * vec4(SCREEN_UV * 2.0 - 1.0, __depth_tex, 1.0);
		__depth_world_pos.xyz /= __depth_world_pos.w;
		n_out3p0 = clamp(1.0 - smoothstep(__depth_world_pos.z + n_out5p0, __depth_world_pos.z, VERTEX.z), 0.0, 1.0);
	}


// FloatOp:4
	float n_out4p0 = n_out2p4 * n_out3p0;


// Output:0
	ALBEDO = vec3(n_out2p0.xyz);
	ALPHA = n_out4p0;


}

void light() {
// FloatConstant:7
	float n_out7p0 = 0.000000;


// FloatConstant:6
	float n_out6p0 = 0.100000;


// Input:2
	vec3 n_out2p0 = NORMAL;


// Fresnel:4
	float n_in4p3 = 1.00000;
	float n_out4p0 = pow(clamp(dot(NORMAL, VIEW), 0.0, 1.0), n_in4p3);


// DotProduct:3
	float n_out3p0 = dot(n_out2p0, vec3(n_out4p0));


// SmoothStep:5
	vec3 n_out5p0 = smoothstep(vec3(n_out7p0), vec3(n_out6p0), vec3(n_out3p0));


// FloatConstant:10
	float n_out10p0 = 0.100000;


// FloatConstant:9
	float n_out9p0 = 1.000000;


// Clamp:8
	vec3 n_out8p0 = clamp(n_out5p0, vec3(n_out10p0), vec3(n_out9p0));


// Output:0
	DIFFUSE_LIGHT = n_out8p0;


}
