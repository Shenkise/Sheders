code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform vec4 aura_color : source_color = vec4(1.000000, 1.000000, 1.000000, 1.000000);
uniform float aura_intesity = 1;
uniform vec2 effect_direction = vec2(0.000000, 1.000000);
uniform sampler2D tex_frg_18;
uniform sampler2D tex_frg_12;
uniform sampler2D tex_frg_2;
uniform sampler2D tex_frg_13;



void fragment() {
// ColorParameter:3
	vec4 n_out3p0 = aura_color;


// FloatParameter:4
	float n_out4p0 = aura_intesity;


// VectorOp:5
	vec4 n_out5p0 = n_out3p0 * vec4(n_out4p0);


// Input:7
	float n_out7p0 = TIME;


// Vector2Parameter:8
	vec2 n_out8p0 = effect_direction;


// VectorOp:9
	vec2 n_out9p0 = vec2(n_out7p0) * n_out8p0;


// UVFunc:15
	vec2 n_in15p1 = vec2(0.00000, 1.00000);
	vec2 n_out15p0 = n_out9p0 * n_in15p1 + UV;


// Texture2D:18
	vec4 n_out18p0 = texture(tex_frg_18, n_out15p0);
	float n_out18p1 = n_out18p0.r;


// Texture2D:12
	vec4 n_out12p0 = texture(tex_frg_12, UV);
	float n_out12p1 = n_out12p0.r;


// FloatOp:16
	float n_out16p0 = n_out18p1 * n_out12p1;


// UVFunc:6
	vec2 n_in6p1 = vec2(0.00000, -1.00000);
	vec2 n_out6p0 = n_out9p0 * n_in6p1 + UV;


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, n_out6p0);
	float n_out2p1 = n_out2p0.r;


// Texture2D:13
	vec4 n_out13p0 = texture(tex_frg_13, UV);
	float n_out13p1 = n_out13p0.r;


// FloatOp:11
	float n_out11p0 = n_out2p1 * n_out13p1;


// FloatOp:17
	float n_out17p0 = n_out16p0 + n_out11p0;


// Output:0
	ALBEDO = vec3(n_out5p0.xyz);
	ALPHA = n_out17p0;


}
